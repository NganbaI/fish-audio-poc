# --- Supabase (Auth + Postgres) ---
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, used by the Fish webhook to write call records.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Fish Audio ---
# Fish Audio API key (Voice Agents access). https://fish.audio/app/api-keys/
FISH_API_KEY=

# Secret used to HMAC-verify inbound Fish webhooks (set the same value in the Fish console).
FISH_WEBHOOK_SECRET=

# Public HTTPS base URL for the webhook receiver during dev (e.g. an ngrok URL).
# Point the Fish console webhook at ${PUBLIC_BASE_URL}/api/webhooks/fish
PUBLIC_BASE_URL=

# Fish API base (override only if needed).
FISH_API_BASE=https://api.fish.audio

# Legacy: default agent id for the standalone setup script. Optional now that
# agents are created in-app; the browser test passes an explicit agentId.
FISH_AGENT_ID=
