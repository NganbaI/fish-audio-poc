# Fish Audio API key (Voice Agents access). https://fish.audio/app/api-keys/
FISH_API_KEY=

# Secret used to HMAC-verify inbound Fish webhooks (set the same value in the Fish console).
FISH_WEBHOOK_SECRET=

# The published agent id — filled in by `npm run setup:agent`.
FISH_AGENT_ID=

# Public HTTPS base URL for the webhook receiver during dev (e.g. an ngrok URL).
# Point the Fish console webhook at ${PUBLIC_BASE_URL}/api/webhooks/fish
PUBLIC_BASE_URL=

# Fish API base (override only if needed).
FISH_API_BASE=https://api.fish.audio
